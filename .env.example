# =============================================================
# AI Knowledge Assistant — Environment Variables
# Скопируй этот файл в .env и заполни своими значениями
# =============================================================

# ── OpenAI / ProxyAPI ────────────────────────────────────────
# Используй ProxyAPI для доступа из России
OPENAI_API_KEY=your_proxyapi_key_here
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Модели
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ── Прокси (Karing / локальный SOCKS5) ──────────────────────
# Для Telegram бота — HTTP прокси через Karing
# Формат: socks5://127.0.0.1:3067 или http://127.0.0.1:7890
HTTP_PROXY=socks5://host.docker.internal:3067
HTTPS_PROXY=socks5://host.docker.internal:3067

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Supabase (PostgreSQL) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
# Прямой DSN для asyncpg (опционально, если нужен прямой доступ)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=knowledge_base

# ── FastAPI ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_to_random_secret_32chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# ── RAG параметры ────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ── Логирование ──────────────────────────────────────────────
LOG_LEVEL=INFO
